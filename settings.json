    "performance": {
        "cache_size_mb": 500,
        "max_file_size_gb": 3,
        "chunk_size": 5000,
        "enable_monitoring": true
    },
    "analytics": {
        "enabled": false,
        "google-analytics": {
            "enabled": false,
            "tag": ""
        },
        "piwik-pro": {
            "enabled": false,
            "tag": "57690c44-d635-43b0-ab43-f8bd3064ca06"
        }
    },
    "advanced": {
        "test": true,
        "workspaces_dir": "..",
        "online_deployment": false
    }
