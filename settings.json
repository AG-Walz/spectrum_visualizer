{
    "app-name": "SpecViz",
    "github-user": "ngarciar24",
    "version": "0.0.1",
    "repository-name": "specviz-gui",
    "enable_workspaces": true,
    "ui": {
        "theme": "light",
        "sidebar_expanded": true,
        "debug_mode": false
    },
    "data_directories": {
        "default": "/mnt/volume"
    },
    "file_browser": {
        "enable_server_browser": true,
        "enable_upload": true,
        "default_tab": "server",
        "unrestricted_access": true
    },
    "models": {
        "default": "ms2pip_timsTOF2024",
        "available": [
            "ms2pip_timsTOF2024",
            "ms2pip_HCD2021",
            "Prosit_2019_intensity",
            "AlphaPept_ms2_generic"
        ]
    },
    "spectrum_analysis": {
        "default_ion_types": {
            "a": false,
            "b": true,
            "c": false,
            "x": false,
            "y": true,
            "z": false,
            "loss": false,
            "precursor": false,
            "prefix": false,
            "immonium": false
        },
        "default_fragment_mass_tolerance": 0.02,
        "default_max_fragment_charge": 2,
        "default_collision_energy": 35,
        "default_instrument_type": "TIMSTOF"
