[flake8]
# Relax flake8 for Streamlit apps
max-line-length = 120
ignore = 
    E501,  # line too long (handled by black)
    W503,  # line break before binary operator
    E203,  # whitespace before ':'
    F401,  # imported but unused (some imports are for shared_imports)
exclude = 
    .git,
    __pycache__,
    .venv,
    venv,
    env,
    .eggs,
    *.egg
